<Window x:Class="LuauGhirda.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:LuauGhirda.UI"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="LuauGhirda V1.0.0" Width="1220" Height="800" MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Foreground="{StaticResource Brush.Text}" FontFamily="{StaticResource Font.UI}"
        Icon="Assets/icon.ico">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="56"
                            ResizeBorderThickness="8"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="WinBtn" TargetType="Button">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="9" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FF1B1B26"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FF14141C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="WinBtnClose" TargetType="Button" BasedOn="{StaticResource WinBtn}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="9" Background="{TemplateBinding Background}">
                            <ContentPresenter x:Name="cp" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FFE8112D"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FFC00E24"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootMargin" Margin="12">
        <Border x:Name="Chrome" CornerRadius="10" Background="{StaticResource Brush.Bg}"
                BorderBrush="#FF1E1E28" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="40" ShadowDepth="0" Opacity="0.55" Color="#FF000000"/>
            </Border.Effect>

            <Grid ClipToBounds="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="64"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- ============ ICON RAIL ============ -->
                    <Border Grid.Column="0" Background="{StaticResource Brush.Rail}"
                            BorderBrush="#FF1C1C26" BorderThickness="0,0,1,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,16,0,0" HorizontalAlignment="Center">
                                <Image x:Name="RailLogo"
       Width="34" Height="34"
       Stretch="UniformToFill"
       Source="/Assets/logo.png"
       RenderOptions.BitmapScalingMode="HighQuality">
                                    <Image.Clip>
                                        <RectangleGeometry Rect="0,0,34,34" RadiusX="9" RadiusY="9"/>
                                    </Image.Clip>
                                </Image>
                            </Grid>

                            <StackPanel x:Name="NavButtons" Grid.Row="1" Margin="0,18,0,0"/>

                            <StackPanel Grid.Row="2" HorizontalAlignment="Center" Margin="0,0,0,14">
                                <Button x:Name="HelpButton" Style="{StaticResource WinBtn}" Margin="0,0,0,10"
                                        Click="OnHelp" ToolTip="Replay the mascot tour">
                                    <ui:Icon IconName="circlehelp" Width="19" Height="19" Stroke="#FFA0A0B0"/>
                                </Button>
                                <StackPanel x:Name="RuntimeChips" HorizontalAlignment="Left" Margin="10,0,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- ============ MAIN COLUMN ============ -->
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="56"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- topbar -->
                        <Border Grid.Row="0" BorderBrush="#FF1C1C26" BorderThickness="0,0,0,1">
                            <Grid Margin="18,0,14,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock x:Name="PageTitle" Text="Deobfuscator" FontSize="15" FontWeight="SemiBold"
                                               Foreground="{StaticResource Brush.Text}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="PageSubtitle" Text="deobfuscate here"
                                               FontSize="11" Foreground="{StaticResource Brush.Text3}"
                                               VerticalAlignment="Center" Margin="12,1,0,0"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                                    <Border CornerRadius="9" Background="#FF17171F" BorderBrush="#FF22222C" BorderThickness="1"
                                            Padding="9,3.5" VerticalAlignment="Center">
                                        <TextBlock Text="V1.0.0" FontSize="10" FontFamily="{StaticResource Font.Mono}"
                                                   Foreground="{StaticResource Brush.Text2}"/>
                                    </Border>
                                    <Button x:Name="MinButton" Style="{StaticResource WinBtn}" Click="OnMinimize">
                                        <Path Data="M 0 4.5 H 10" Stroke="#FFA0A0B0" StrokeThickness="1.4"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="None"/>
                                    </Button>
                                    <Button x:Name="MaxButton" Style="{StaticResource WinBtn}" Click="OnMaximize">
                                        <Rectangle Width="9" Height="9" Stroke="#FFA0A0B0" StrokeThickness="1.4" Fill="Transparent"
                                                   RadiusX="2" RadiusY="2"/>
                                    </Button>
                                    <Button x:Name="CloseButton" Style="{StaticResource WinBtnClose}" Click="OnClose">
                                        <Path x:Name="CloseGlyph" Data="M 0 0 L 9 9 M 9 0 L 0 9" Stroke="#FFA0A0B0" StrokeThickness="1.4"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="None"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- page host -->
                        <ScrollViewer x:Name="PageScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                      Padding="16,14,16,14">
                            <ContentControl x:Name="PageHost" Focusable="False"/>
                        </ScrollViewer>
                    </Grid>
                </Grid>

                <!-- dropdown + tutorial overlay -->
                <Grid x:Name="OverlayHost"/>
            </Grid>
        </Border>
    </Grid>
</Window>
