<Application x:Class="LuauGhirda.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>

        <!-- ============================================================
             GHIRDA DESIGN LANGUAGE V2 — modern dashboard, black theme,
             purple accent (from the snake logo). Soft rounded cards on
             near-black, one violet accent, lucide line icons.
             ============================================================ -->

        <Color x:Key="C.Bg">#FF060609</Color>
        <Color x:Key="C.Rail">#FF08080C</Color>
        <Color x:Key="C.Card">#FF131319</Color>
        <Color x:Key="C.CardHi">#FF17171F</Color>
        <Color x:Key="C.CardBorder">#FF1E1E27</Color>
        <Color x:Key="C.CardBorderHi">#FF2E2E3C</Color>
        <Color x:Key="C.Text">#FFF2F2F7</Color>
        <Color x:Key="C.Text2">#FFA0A0B0</Color>
        <Color x:Key="C.Text3">#FF606070</Color>
        <Color x:Key="C.Accent">#FFA855F7</Color>
        <Color x:Key="C.AccentHi">#FFC084FC</Color>
        <Color x:Key="C.AccentDeep">#FF7C3AED</Color>
        <Color x:Key="C.Tint">#FF1D1428</Color>
        <Color x:Key="C.Field">#FF0D0D13</Color>
        <Color x:Key="C.Warn">#FFF5B841</Color>
        <Color x:Key="C.Err">#FFF87171</Color>
        <Color x:Key="C.Good">#FF4ADE80</Color>

        <SolidColorBrush x:Key="Brush.Bg" Color="{StaticResource C.Bg}"/>
        <SolidColorBrush x:Key="Brush.Rail" Color="{StaticResource C.Rail}"/>
        <SolidColorBrush x:Key="Brush.Card" Color="{StaticResource C.Card}"/>
        <SolidColorBrush x:Key="Brush.CardHi" Color="{StaticResource C.CardHi}"/>
        <SolidColorBrush x:Key="Brush.CardBorder" Color="{StaticResource C.CardBorder}"/>
        <SolidColorBrush x:Key="Brush.CardBorderHi" Color="{StaticResource C.CardBorderHi}"/>
        <SolidColorBrush x:Key="Brush.Text" Color="{StaticResource C.Text}"/>
        <SolidColorBrush x:Key="Brush.Text2" Color="{StaticResource C.Text2}"/>
        <SolidColorBrush x:Key="Brush.Text3" Color="{StaticResource C.Text3}"/>
        <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource C.Accent}"/>
        <SolidColorBrush x:Key="Brush.AccentHi" Color="{StaticResource C.AccentHi}"/>
        <SolidColorBrush x:Key="Brush.AccentDeep" Color="{StaticResource C.AccentDeep}"/>
        <SolidColorBrush x:Key="Brush.Tint" Color="{StaticResource C.Tint}"/>
        <SolidColorBrush x:Key="Brush.Field" Color="{StaticResource C.Field}"/>
        <SolidColorBrush x:Key="Brush.Warn" Color="{StaticResource C.Warn}"/>
        <SolidColorBrush x:Key="Brush.Err" Color="{StaticResource C.Err}"/>
        <SolidColorBrush x:Key="Brush.Good" Color="{StaticResource C.Good}"/>

        <LinearGradientBrush x:Key="Brush.AccentGrad" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FFA855F7" Offset="0.0"/>
            <GradientStop Color="#FF7C3AED" Offset="1.0"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="Brush.AccentGradSoft" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FFB366FF" Offset="0.0"/>
            <GradientStop Color="#FF8B5CF6" Offset="1.0"/>
        </LinearGradientBrush>

        <FontFamily x:Key="Font.Mono">Cascadia Mono, Consolas, Courier New</FontFamily>
        <FontFamily x:Key="Font.UI">Segoe UI Variable Text, Segoe UI</FontFamily>

        <!-- ============================== INPUTS ============================== -->

        <Style x:Key="Box" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource Brush.Field}"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
            <Setter Property="CaretBrush" Value="{StaticResource Brush.AccentHi}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Brush.CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontFamily" Value="{StaticResource Font.UI}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="SelectionBrush" Value="#66A855F7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center" Focusable="False"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Brush.CardBorderHi}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Brush.AccentDeep}"/>
                                <Setter TargetName="bd" Property="Background" Value="#FF12121A"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CodeBox" TargetType="TextBox" BasedOn="{StaticResource Box}">
            <Setter Property="FontFamily" Value="{StaticResource Font.Mono}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="AcceptsTab" Value="True"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="VerticalContentAlignment" Value="Top"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
        </Style>

        <!-- dark rounded button -->
        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Background" Value="#FF1F1F2A"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.Text2}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Brush.CardBorder}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="10" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FF26263A"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Brush.AccentDeep}"/>
                                <Setter Property="Foreground" Value="{StaticResource Brush.AccentHi}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FF1A1A24"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================== SCROLLBARS ============================== -->

        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="9"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="tb" CornerRadius="4.5" Background="#FF2A2A36" Margin="1,0"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="tb" Property="Background" Value="#FF3A3A4A"/>
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="tb" Property="Background" Value="{StaticResource Brush.AccentDeep}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="Height" Value="9"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ScrollViewer">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <ScrollContentPresenter Grid.Column="0" Grid.Row="0"/>
                            <ScrollBar Grid.Column="1" Grid.Row="0" Name="PART_VerticalScrollBar"
                                       Value="{TemplateBinding VerticalOffset}"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Orientation="Vertical"/>
                            <ScrollBar Grid.Column="0" Grid.Row="1" Name="PART_HorizontalScrollBar"
                                       Value="{TemplateBinding HorizontalOffset}"
                                       Maximum="{TemplateBinding ScrollableWidth}"
                                       ViewportSize="{TemplateBinding ViewportWidth}"
                                       Orientation="Horizontal"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- tooltips -->
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="#FF1C1C26"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Brush.CardBorderHi}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border CornerRadius="8" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Application.Resources>
</Application>
