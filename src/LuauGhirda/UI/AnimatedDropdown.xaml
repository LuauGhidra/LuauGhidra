<UserControl x:Class="LuauGhirda.UI.AnimatedDropdown"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False">
    <Grid x:Name="Root">
        <Border x:Name="HeaderBorder" CornerRadius="11" Background="{StaticResource Brush.Field}"
                BorderBrush="{StaticResource Brush.CardBorder}" BorderThickness="1"
                Cursor="Hand" MouseLeftButtonUp="OnHeaderClick" Height="36">
            <Grid Margin="13,0,11,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="SelectedText" Grid.Column="0"
                           VerticalAlignment="Center" FontSize="12"
                           FontFamily="{StaticResource Font.UI}"
                           Foreground="{StaticResource Brush.Text}" Text="Select…"/>
                <Path x:Name="Chevron" Grid.Column="1" Data="M 0 0 L 4.5 4.5 L 9 0" Stroke="#FFA0A0B0"
                      StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center"
                      Margin="6,1,0,0" RenderTransformOrigin="0.5,0.5">
                    <Path.RenderTransform>
                        <RotateTransform Angle="0" CenterX="4.5" CenterY="2.25"/>
                    </Path.RenderTransform>
                </Path>
            </Grid>
        </Border>
    </Grid>
</UserControl>
