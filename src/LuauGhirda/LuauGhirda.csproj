<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>LuauGhirda</RootNamespace>
    <AssemblyName>LuauGhirda</AssemblyName>
    <Version>1.0.0</Version>
    <InformationalVersion>1.0.0</InformationalVersion>
    <Product>LuauGhirda</Product>
    <Description>LuauGhirda — open-source Luau deobfuscation workbench with a custom animated WPF interface: bundled engines, lua.expert cloud decompiler, outputs folder and one-click share links.</Description>
    <Authors>LuauGhirda contributors</Authors>
    <PublishSinglePage Condition="'$(Configuration)' == 'Release'">false</PublishSinglePage>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- exe icon in Explorer -->
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\icon.ico" />
  </ItemGroup>

	<ItemGroup>
		<Resource Include="Assets\**\*" />
	</ItemGroup>

  <ItemGroup>
    <!-- embedded as an assembly resource so Window Icon="Assets/icon.ico" resolves at runtime -->
    <Resource Include="Assets\icon.ico" />
    <Resource Include="Assets\logo.png" />
    <Resource Include="Assets\mark.png" />
    <Resource Include="Assets\illust_dev.png" />
    <Resource Include="Assets\illust_bug.png" />
    <Resource Include="Assets\illust_celebrate.png" />
  </ItemGroup>

</Project>
